#!/usr/bin/env bash
# Jarvis OS production CLI — generated by scripts/install_prod_cli.sh. DO NOT EDIT.
# Rendered from deploy/jarvis.cli.template; re-run the installer to update it.
#
# The three exports below are the SAME values deploy/jarvis.service.template carries,
# so a command typed in a shell and a command the daemon runs reach ONE fleet. Without
# them `jarvis` runs production code against ~/.jarvis, the dev instance's home
# (paths.jarvis_home()) — issue 757.
export JARVIS_HOME="@PROD_ROOT@/state"
export PRODUCTION_CODE="@PROD_ROOT@"
export JARVIS_ENV=production
exec "@PROD_DIR@/.venv/bin/jarvis" "$@"
