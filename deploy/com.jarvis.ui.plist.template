<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Jarvis OS production dashboard, the macOS counterpart of jarvis-ui.service.template.
     Rendered by scripts/install_prod_service.sh into ~/Library/LaunchAgents. DO NOT EDIT. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jarvis.ui</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PROD_DIR@/.venv/bin/jarvis</string>
    <string>ui</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>@UI_PORT@</string>
  </array>
  <key>WorkingDirectory</key><string>@PROD_DIR@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JARVIS_HOME</key><string>@PROD_ROOT@/state</string>
    <key>PRODUCTION_CODE</key><string>@PROD_ROOT@</string>
    <key>JARVIS_ENV</key><string>production</string>
    <key>HOME</key><string>@HOME@</string>
    <key>PATH</key><string>@PATH@</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ExitTimeOut</key><integer>15</integer>
  <key>StandardOutPath</key><string>@PROD_ROOT@/state/logs/ui.launchd.log</string>
  <key>StandardErrorPath</key><string>@PROD_ROOT@/state/logs/ui.launchd.log</string>
</dict>
</plist>
